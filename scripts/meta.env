APP_SLUG=deepseek-harness
DISPLAY_NAME="DeepSeek Harness"
UPSTREAM_REPO=https://github.com/deepseek-ai/deepseek-harness
UPSTREAM_TYPE=npm
UPSTREAM_PACKAGE=@deepseek-ai/dsh
SERVICE_PORT=3080
NODE_VERSION=24.4.0
DSH_FALLBACK_VERSION=0.1.1-rc.2
# 内置插件清单：随 app.tgz 离线打包，runner.js 首次启动自动装入指定 profile
# 格式：空格分隔的包名；不带版本号，构建时自动解析 npm 最新版
BUNDLED_DSH_PLUGINS=dshmarket
# 插件安装到的 DSH profile（与 Web UI 使用的 profile 一致）
DSH_PLUGIN_PROFILE=web
